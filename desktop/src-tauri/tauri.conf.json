{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dico",
  "version": "1.0.4",
  "identifier": "fr.dico.popup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dico",
        "width": 664,
        "height": 524,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost; img-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.dico/**",
          "$HOME/.dico/audio/*"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dico.py": "dico.py",
      "../../data/lexique.db": "data/lexique.db",
      "../../data/conjugations.db": "data/conjugations.db",
      "../../data/grammalecte": "data/grammalecte",
      "cli": "dico-cli"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French",
          "Russian"
        ]
      }
    }
  }
}
